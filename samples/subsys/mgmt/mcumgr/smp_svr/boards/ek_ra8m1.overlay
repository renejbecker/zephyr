
// get rid of the too small storage partition defined in ek_ra8m1.dts
/delete-node/ &storage_partition;

/ {
    chosen {
		zephyr,code-partition = &slot0_partition;
		zephyr,uart-mcumgr = &cdc_acm_uart0;
	};

